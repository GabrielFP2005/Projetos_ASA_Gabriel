Vagrant.configure("2") do |config|
    # General Vagrant VM configuration.
    config.vm.box = "debian/bookworm64"
    config.ssh.insert_key = false
    
    if Vagrant.has_plugin?("vagrant-vbguest")
        config.vbguest.auto_update = false
    end
    config.vm.synced_folder ".", "/vagrant", disabled: true
    config.vm.provider :virtualbox do |v|
        v.memory = 512
        v.linked_clone = true
        v.check_guest_additions = false
    end
    config.trigger.before :"Vagrant::Action::Builtin::WaitForCommunicator", type: :action do |t|
        t.warn = "Iterrompe o servidor dhcp do virtualbox"
        t.run = {inline: "vboxmanage dhcpserver stop --interface vboxnet0"}
    end
 
    # www server.
    config.vm.define "www" do |www|
        www.vm.hostname = "www.gabrielpalmeira.devops"
        www.vm.network :private_network, ip: "192.168.56.16"
        www.vm.provision "ansible" do |ansible|
            ansible.compatibility_mode = "2.0"
            ansible.playbook = "playbooks/cria-site.yml"
        end
    end
 
    # DNS and DHCP server.
    config.vm.define "dns" do |dns|
        dns.vm.hostname = "dns.gabrielpalmeira.devops"
        dns.vm.network :private_network, ip: "192.168.56.116"
        dns.vm.provision "ansible" do |ansible|
            ansible.compatibility_mode = "2.0"
            ansible.playbook = "playbooks/conf-dns-dhcp.yml"
        end
    end
    # Client.
    config.vm.define "cli" do |cli|
        cli.vm.hostname = "cli.gabrielpalmeira.devops"
        cli.vm.network :private_network, type: "dhcp"
    end
end
